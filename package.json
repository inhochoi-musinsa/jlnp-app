{
  "name": "jlpt-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "JLPT study app: single-file dist/index.html + external content CLI",
  "scripts": {
    "build": "node scripts/build-single-html.mjs",
    "serve": "node scripts/serve.mjs",
    "size": "node scripts/measure-size.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint:level-neutral && npm run test && npm run build",
    "lint:level-neutral": "node scripts/level-neutral.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
