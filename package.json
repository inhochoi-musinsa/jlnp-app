{
  "name": "jlpt-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JLPT study app: single-file dist/index.html + external content CLI",
  "scripts": {
    "build": "node scripts/build-single-html.mjs",
    "serve": "node scripts/serve.mjs",
    "size": "node scripts/measure-size.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint:level-neutral && npm run scan:secrets && npm run test && npm run build",
    "lint:level-neutral": "node scripts/level-neutral.mjs",
    "content:doctor": "tsx tools/content/src/cli.ts doctor",
    "content:catalog": "tsx tools/content/src/cli.ts catalog",
    "content:gen": "tsx tools/content/src/cli.ts gen",
    "content:verify": "tsx tools/content/src/cli.ts verify",
    "content:pack": "tsx tools/content/src/cli.ts pack",
    "content:ledger": "tsx tools/content/src/cli.ts ledger",
    "content:sample": "tsx tools/content/src/cli.ts sample",
    "content:seed": "tsx tools/content/src/cli.ts seed",
    "deploy": "node scripts/deploy-pages.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "content:plan": "tsx tools/content/src/cli.ts plan",
    "content:fill": "tsx tools/content/src/cli.ts fill",
    "content:audio": "tsx tools/content/src/cli.ts audio"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "kuromoji": "^0.1.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
